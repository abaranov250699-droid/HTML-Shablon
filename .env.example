# ============================================================================
# ПАРАМЕТРЫ ОКРУЖЕНИЯ (ENVIRONMENT VARIABLES)
# Скопируйте этот файл в .env и укажите свои параметры
# ============================================================================

# Порт веб-сервера (локально 3000, на Render.com выставляется автоматически)
PORT=3000

# Режим работы (development / production)
NODE_ENV=development

# Секретный ключ для подписи JWT токенов
JWT_SECRET=super_secret_jwt_key_power_sales_bi_2026_neon_render

# Подключение к облачной БД PostgreSQL на Neon.tech (регион eu-central-1)
# Пример строки подключения из панели https://console.neon.tech
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-solitary-voice-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
